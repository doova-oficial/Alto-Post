# Copie para .env e preencha. NUNCA versione o arquivo .env.

# ------------------------------------------------------------------ geral
APP_ENV=development                 # development | production | test
LOG_LEVEL=INFO
TIMEZONE=America/Sao_Paulo
# Local: SQLite. Produção: PostgreSQL (ex.: postgresql://usuario:senha@host:5432/doova)
DATABASE_URL=sqlite:///./data/doova.db
GENERATED_DIR=./generated
BACKUP_DIR=./data/backups
BACKUP_KEEP=14
DOCS_ENABLED=true

# ------------------------------------------------------------- segurança
# Gere com: python -m app.cli gen-token   (mínimo 24 caracteres)
ADMIN_API_TOKEN=
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_GENERATION_PER_MINUTE=10
# Necessária para renovar e guardar o token da Meta automaticamente. Gere com: python -m app.cli gen-key
TOKEN_ENCRYPTION_KEY=

# ----------------------------------------------------------------- Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=3
GROQ_MIN_INTERVAL_SECONDS=2
GROQ_TEMPERATURE=0.7
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_REASONING_EFFORT=low           # low | medium | high (modelos gpt-oss)

# ------------------------------------------------------------- legendas
CAPTION_ALLOW_EMOJIS=false
CAPTION_MAX_HASHTAGS=3
CAPTION_MIN_CHARS=40
CAPTION_MAX_CHARS=900
CAPTION_MAX_ATTEMPTS=4

# ----------------------------------------------------------------- Meta
META_LOGIN_TYPE=unified             # unified (SUAT/graph.facebook.com) | instagram | facebook
META_GRAPH_API_VERSION=v26.0
META_IG_USER_ID=
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_TIMEOUT_SECONDS=30
# URL pública HTTPS deste serviço. A Meta baixa a imagem em PUBLIC_BASE_URL/media/<token>.jpg
PUBLIC_BASE_URL=

# ------------------------------------------------------------ publicação
DRY_RUN=true                        # true = simulação: nada é enviado ao Instagram
REQUIRE_MANUAL_APPROVAL=false      # false = modo automático: aprova, agenda e publica sozinho
MAX_POSTS_PER_DAY=2
MIN_MINUTES_BETWEEN_POSTS=180
PUBLISH_MAX_ATTEMPTS=3
CONTAINER_MAX_CHECKS=6
CONTAINER_CHECK_INTERVAL_SECONDS=5
AUTO_SCHEDULE=true                  # agenda automaticamente as aprovadas
POSTING_WEEKDAYS=0,1,2,3,4,5,6      # 0=segunda ... 6=domingo
POSTING_STRATEGY=adaptive           # adaptive = aprende o melhor horário; fixed = só POSTING_SLOTS
POSTING_CANDIDATE_SLOTS=07:30,09:00,11:30,12:30,15:00,18:00,19:30,21:00
POSTING_SLOTS=11:30,19:00           # usados quando POSTING_STRATEGY=fixed
TIMING_MIN_SAMPLES=3                # publicações medidas por horário antes de escolher os melhores
TIMING_EXPLORE_RATE=0.2             # parte dos dias que continua testando outros horários
TREND_PUBLISH_ASAP=true             # assunto do momento sai o quanto antes

# ------------------------------------------- modo automático: vigilância
ALERT_WEBHOOK_URL=                  # Discord, Slack, ntfy (https://ntfy.sh/seu-topico) ou URL que aceite JSON
ALERT_WEBHOOK_KIND=auto
AUTO_PAUSE_FAILURES=3               # falhas definitivas em 24 h que pausam a publicação
QUEUE_MIN_DAYS=2                    # avisa quando a fila cobre menos dias que isso
PHOTO_AUTO_CHECK=true               # recusa fotos com pessoas ou marcas no título/tags

# ------------------------------------------------------------ agendador
SCHEDULER_ENABLED=true
PUBLISHER_INTERVAL_SECONDS=60
METRICS_INTERVAL_HOURS=6
METRICS_MAX_AGE_DAYS=30
INSTANCE_ID=

# ------------------------------------------------------------- análises
ANALYSIS_TARGET_AGE_HOURS=72
ANALYSIS_MIN_SAMPLES_PER_GROUP=5
ANALYSIS_ALPHA=0.05
ANALYSIS_PERMUTATIONS=5000

# ------------------------------------------------------------- tendências
GOOGLE_TRENDS_RSS_ENABLED=true
GOOGLE_TRENDS_GEO=BR

# ------------------------------------------------- fotos de bancos gratuitos
IMAGE_SEARCH_ENABLED=true
IMAGE_PROVIDERS=openverse,pixabay     # ordem de busca
PIXABAY_API_KEY=                      # opcional (grátis em https://pixabay.com/api/docs/); sem chave usa só o Openverse
VIDEO_ENABLED=true                    # gera reels verticais ao processar tendências
VIDEO_PROVIDER=pixabay
VIDEO_DURATION_SECONDS=12
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FONT_SIZE=64
IMAGE_SEARCH_TIMEOUT_SECONDS=20
IMAGE_SEARCH_CACHE_HOURS=24           # mínimo 24 (exigência do Pixabay)
IMAGE_MIN_WIDTH=900
IMAGE_REUSE_DAYS=60                   # não repete a mesma foto nesse período
CONTACT_EMAIL=                        # vai no User-Agent das buscas

# ----------------------------------------- assuntos do momento (automático)
TREND_AUTO_ENABLED=true              # true = cria publicações com foto a partir do Google Trends
TREND_AUTO_INTERVAL_HOURS=6
TREND_AUTO_MAX_PER_DAY=1
TREND_POST_TTL_HOURS=48               # cancela se não for publicada nesse prazo
TREND_BLOCKLIST_EXTRA=                # palavras proibidas extras, separadas por vírgula
TREND_USE_GROQ=true                   # a Groq ajuda a encaixar/vetar assuntos (a triagem por palavras sempre roda)

# ------------------------------------------------------------- fontes
# Pasta opcional com fontes .ttf/.otf próprias (tem prioridade sobre as incluídas)
DOOVA_FONT_DIR=
